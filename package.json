{
  "name": "@bartekrozycki/copilot-paperclip-adapter",
  "version": "0.1.0",
  "description": "Paperclip external adapter for the GitHub Copilot CLI (copilot_local)",
  "keywords": [
    "paperclip",
    "adapter",
    "copilot",
    "github-copilot",
    "agent"
  ],
  "license": "MIT",
  "author": "Bartosz Rozycki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartekrozycki/copilot-paperclip-adapter.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./ui-parser": "./dist/ui-parser.cjs"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.1005.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "homepage": "https://github.com/bartekrozycki/copilot-paperclip-adapter#readme",
  "bugs": {
    "url": "https://github.com/bartekrozycki/copilot-paperclip-adapter/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
